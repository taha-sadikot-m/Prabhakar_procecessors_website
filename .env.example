# Neon Postgres connection string (required for CMS APIs)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Static admin credentials (no user table). Login at /admin/login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# HS256 secret for admin JWT (use a long random string)
JWT_SECRET=change-me-to-a-long-random-string

# Ops:
# 1. Apply schema: psql "$DATABASE_URL" -f db/schema.sql
#    (or paste db/schema.sql into the Neon SQL editor)
# 2. Seed services + testimonials:
#      npm run seed:cms
#    PowerShell one-off without .env file:
#      $env:DATABASE_URL="postgresql://..."; npm run seed:cms
# 3. Local (frontend + API, no Vercel CLI):
#      npm run dev
#    Opens Vite on :5173 and proxies /api to local Express on :8787
#    Admin: http://localhost:5173/admin/login
#    Frontend-only: npm run dev:vite
# 4. Production (same app URL on Vercel):
#    Set the same env vars on the Vercel project, then deploy.
#    Site + /admin + /api share that one URL.
